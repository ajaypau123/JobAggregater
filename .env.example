# ──────────────────────────────────────────────
# Job Aggregator V1 — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────

# ── Remotive ──────────────────────────────────
# No API key required. APPROVED for aggregation.
# No config needed.

# ── Jobicy ────────────────────────────────────
# No API key required. APPROVED for aggregation.
# No config needed.

# ── Himalayas ─────────────────────────────────
# No API key required. APPROVED for aggregation.
# No config needed.

# ── Adzuna ────────────────────────────────────
# Register for a free key at: https://developer.adzuna.com/
# IMPORTANT: All displayed listings must show "Jobs by Adzuna" badge (116x23px).
ADZUNA_APP_ID=your_app_id_here
ADZUNA_APP_KEY=your_app_key_here

# Comma-separated list of Adzuna country codes to query.
# Supported: gb, us, au, ca, de, fr, in, nl, nz, pl, ru, sg, za, br, mx, at, be
ADZUNA_COUNTRIES=in,gb,us

# ── Arbeitnow ─────────────────────────────────
# DISABLED — permission_status=REVIEW_REQUIRED.
# Terms are unclear for commercial/public aggregation.
# Contact contact@arbeitnow.com for a private agreement before enabling.
ARBEITNOW_API_URL=https://www.arbeitnow.com/api/job-board-api
